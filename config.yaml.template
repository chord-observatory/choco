# choco configuration
# Copy this file to config.yaml and edit as needed.

server:
  host: 0.0.0.0
  port: 5000                     # iptables redirects 443 -> 5000 (installed by ./choco.sh install)
  secret_key: change-me           # Signs the session cookie, so a guessable key is a login bypass.  choco
                                  # REFUSES TO START with this placeholder or anything under 16 characters.
                                  # `choco.sh install` seeds a random key; by hand:
                                  #   python3 -c 'import secrets; print(secrets.token_hex(32))'
  log_level: INFO
  ssl_cert:                       # Path to SSL certificate (PEM). Leave empty to auto-generate self-signed.
  ssl_key:                        # Path to SSL private key (PEM). Leave empty to auto-generate self-signed.
  http_redirect_port: 8080        # HTTP listener that redirects to HTTPS (iptables redirects 80 -> 8080)
  ssl: true                       # false serves plain HTTP (dev only; see ./choco.sh develop)
  dev_auth:                       # DEV ONLY. Set to a username to disable login AND CSRF for every
                                  # request. choco refuses to start unless server.host is loopback.
                                  # ./choco.sh develop writes this into dev/config.yaml for you.

# Path to the directory containing nodes.yaml and per-node config files.
configs_dir: configs

# kotekan connection settings.
kotekan:
  timeout: 10                       # HTTP request timeout (seconds) for kotekan REST API calls

# Sync system settings.
sync:
  poll_interval: 5                  # Seconds between each node's drift check
  restart_timeout: 10               # Seconds to wait for kotekan to restart after /kill
  max_concurrent_pushes: 4          # Max nodes restarting (kill -> start) at once
  max_retry_interval: 60            # Unreachable nodes back off to this check interval

# FPGA master daemon — serves /status and /get-frame0-time over HTTP.
# Used by choco's service-status strip and by the EOP broadcast job.
fpga_master:
  host: chive.site.chord-observatory.ca
  port: 54321
  timeout: 5                        # HTTP request timeout (seconds)
  control: true                     # show Start/Stop controls on /service/fpga

# Power distribution boards (power_db) — Infineon high-side switches on a
# Raspberry Pi, REST on port 5000.  Feeds the PDB badge and /service/pdb.
# (This block was called psu: before the rename; the old name is still
# read, with a deprecation warning at startup.)
pdb:
  host: 10.222.0.30
  port: 5000
  timeout: 5                        # HTTP request timeout (seconds)
  control: true                     # allow power toggles on /service/pdb
  # Master dish-input <-> channel table; relative paths resolve against
  # configs_dir.  Default: <configs_dir>/pdb_map.csv.
  map_file: pdb_map.csv
  # Node group whose kotekan dish_inputs table the map is cross-checked
  # against.  Unset: the first group in nodes.yaml.
  # kotekan_group: cx

# Earth Orientation Parameter service settings.
eop:
  intervals_before: 2               # Days of past entries (older stored entries are truncated on merge)
  intervals_after: 2                # Days of future entries (later stored entries are kept, never overwritten)
  endpoint: earth_rotation_data     # Kotekan updatable config endpoint name
  state_file: /var/lib/choco/eop/state.json   # State file (absolute; rewritten on every successful run). A relative path is resolved against configs_dir (legacy layout).
  service_unit: choco-eop-broadcast.service  # systemd unit to query for last-run status

# bffs feed-flagging job (BFFS badge in the web UI header).
bffs:
  service_unit: choco-bffs-flag.service  # systemd unit to query for last-run status
  state_file: /var/lib/choco/bffs/state.json   # bffs state.path (absolute; "last change" in the badge tooltip)

# eigencal gain-calibration job (EIGENCAL badge in the web UI header).
eigencal:
  service_unit: choco-eigencal.service       # systemd unit to query for last-run status
  state_file: /var/lib/choco/eigencal/state.json   # eigencal run.state_file (absolute; written once per processed transit)

# waterfall image-rendering job (WF badge, /files column, contact sheet).
# What to render is configured in /etc/choco/waterfall.yaml; these keys are
# what choco needs to read the result back.  Without images_dir the column
# reads "-" for every acquisition and the contact sheet 404s.
waterfall:
  service_unit: choco-waterfall.service       # systemd unit to query for last-run status
  state_file: /var/lib/choco/waterfall/state.json   # waterfall state_file (absolute; rewritten every run)
  images_dir: /mnt/cs00/data/kotekan_vis_files/waterfalls   # must match waterfall.yaml's waterfalls_dir
  ttl: 30                                     # seconds to cache the per-acquisition summary sweep
  timezone: America/Vancouver                 # IANA zone for the viewer's time axis (default shown)

# Current-sky strip plot rendered by the skymap job (jobs/skymap, every
# 5 min; configured in /etc/choco/skymap.yaml).  image_file is where choco
# reads the finished PNG back -- it must match skymap.yaml's output.  The
# image is served unauthenticated at /skymap.png and shown on the landing
# page.  Omit the block to disable both.
skymap:
  image_file: /var/lib/choco/skymap/skymap.png

# Data-file roots shown on /files.  Each root is scanned one level deep:
# its immediate subdirectories are listed with the number, total size and
# newest mtime of the *.h5 files sitting directly in each.  Files staged
# under a .partial subdirectory are not counted -- they are not part of
# the acquisition yet.  Leave roots empty (or omit the block) to disable
# the page.
vis_files:
  roots:
    - /mnt/cs00/data/kotekan_vis_files/full
    - /mnt/cs00/data/kotekan_vis_files/subset
  ttl: 30                           # Seconds to cache a scan (these are NFS mounts)

# FreeIPA LDAP authentication (direct bind: the user's DN is
# <user_login_attr>=<username>,<user_dn>,<base_dn>, bound with their own
# password — no service account needed).
# All routes require login. Leave host empty to disable (dev/testing only).
# Legacy keys from the search-bind era (bind_dn, bind_password,
# user_object_filter, user_search_scope) are ignored if present.
ldap:
  host:                             # e.g. ldaps://ipa1.auth.chord-observatory.ca
  port: 636
  use_ssl: true                     # false sends passwords in cleartext (logged as a warning)
  ca_cert:                          # PEM bundle the LDAP server's certificate must chain to.  Empty: the
                                    # system CA store, where ipa-client-install already put the IPA CA.
                                    # Verification is always on; a path to a missing file is a startup error.
  base_dn:                          # e.g. dc=auth,dc=chord-observatory,dc=ca
  user_dn: cn=users,cn=accounts
  user_login_attr: uid
