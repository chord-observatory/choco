# choco configuration
# Copy this file to config.yaml and edit as needed.

server:
  host: 0.0.0.0
  port: 5000                     # Use iptables to redirect 443 -> 5000 (see ./choco.sh setup-ports)
  secret_key: change-me           # Change this in production!
  log_level: INFO
  ssl_cert:                       # Path to SSL certificate (PEM). Leave empty to auto-generate self-signed.
  ssl_key:                        # Path to SSL private key (PEM). Leave empty to auto-generate self-signed.
  http_redirect_port: 8080        # HTTP listener that redirects to HTTPS (iptables redirects 80 -> 8080)

# Path to the directory containing nodes.yaml and per-node config files.
configs_dir: configs

# kotekan connection settings.
kotekan:
  timeout: 10                       # HTTP request timeout (seconds) for kotekan REST API calls

# Sync system settings.
sync:
  poll_interval: 5                  # Seconds between polling all nodes for drift
  restart_timeout: 10               # Seconds to wait for kotekan to restart after /kill
  num_workers: 4                    # Number of worker greenlets processing node queues

# FPGA master daemon — serves /status and /get-frame0-time over HTTP.
# Used by choco's service-status strip and by the EOP broadcast job.
fpga_master:
  host: chive.site.chord-observatory.ca
  port: 54321
  timeout: 5                        # HTTP request timeout (seconds)

# Analog PSU controller (power_db) — Infineon high-side switches on a
# Raspberry Pi, REST on port 5000.  Feeds the PSU badge and /service/psu.
psu:
  host: 10.222.0.30
  port: 5000
  timeout: 5                        # HTTP request timeout (seconds)

# Earth Orientation Parameter service settings.
eop:
  intervals_before: 2               # Days of past entries (older stored entries are truncated on merge)
  intervals_after: 2                # Days of future entries (later stored entries are kept, never overwritten)
  endpoint: earth_rotation_data     # Kotekan updatable config endpoint name
  state_file: eop-state.json        # State file name (stored in configs_dir)
  service_unit: choco-eop-broadcast.service  # systemd unit to query for last-run status

# bffs feed-flagging job (BFFS badge in the web UI header).
bffs:
  service_unit: choco-bffs-flag.service  # systemd unit to query for last-run status
  state_file: /var/lib/bffs/state.json   # bffs state.path (absolute; "last change" in the badge tooltip)

# eigencal gain-calibration job (EIGENCAL badge in the web UI header).
eigencal:
  service_unit: choco-eigencal.service       # systemd unit to query for last-run status
  state_file: /var/lib/eigencal/state.json   # eigencal run.state_file (absolute; written once per processed transit)

# FreeIPA LDAP authentication.
# All routes require login. Leave host empty to disable (dev/testing only).
ldap:
  host:                             # e.g. ldaps://ipa1.auth.chord-observatory.ca
  port: 636
  use_ssl: true
  base_dn:                          # e.g. dc=auth,dc=chord-observatory,dc=ca
  user_dn: cn=users,cn=accounts
  user_login_attr: uid
  user_object_filter: "(objectclass=posixaccount)"
  bind_dn:                          # e.g. uid=choco,cn=users,cn=accounts,dc=auth,dc=chord-observatory,dc=ca
  bind_password:
