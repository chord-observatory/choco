// Sample kotekan pipeline graph, in kotekan's palette.  Not a live
// capture: a hand-kept sample that exercises every colour and shape
// lib/core/PipelineGraph.cpp can emit -- each node category, the
// device region and its nested memory box, a backed-up buffer, an
// idle one, and the legend.  test_pipeline_palette.py renders this
// and fails on any colour the dark theme does not map.  When
// kotekan's palette changes, refresh this file from a real
// /pipeline_dot and the test will name what is unmapped.
digraph pipeline {
    graph [fontcolor="#1c2430", mclimit="6", newrank="true", nodesep="0.3", rankdir="LR", ranksep="0.9"];
    node [fontname="Helvetica", fontsize="11", fontcolor="#1c2430"];
    edge [fontname="Helvetica", fontsize="8", fontcolor="#1c2430"];
    edge [color="#5c6b7a"];

    subgraph "cluster_/gen" {
        label=<gen>;
        style="rounded";
        color="#aab4bf";
        "/gen/voltage" [label=<voltage<BR/>&lt;testDataGen&gt;<BR/>1 thread · cpu 42%<BR/>cores 2,3>, color="#94800c", fillcolor="#f7edc0", shape="box", style="rounded,filled"];
    }

    "host_voltage_buffer" [label=<host_voltage_buffer<BR/>ndarray · chordMetadata<BR/>int4x2 T:8192 × F:16 × P:2 × D:64<BR/>2 MiB ×4 frames = 8 MiB<BR/>2/4 full (50.0%)<BR/>23.9 frame/s · 195 kB/s<BR/>numa 0 · mlock>, color="#2a6099", fillcolor="#d6e6f7", shape="box", style="rounded,filled"];
    "host_full_buffer" [label=<host_full_buffer<BR/>standard · chordMetadata<BR/>8 KiB ×24 frames = 192 KiB<BR/>24/24 full (100.0%)<BR/>0.82 frame/s>, color="#c0392b", fillcolor="#d6e6f7", penwidth="2.5", shape="box", style="rounded,filled"];
    "host_idle_buffer" [label=<host_idle_buffer<BR/>ndarray · chordMetadata<BR/>0/24 full (0.0%)<BR/>0 frames arrived>, color="#2a6099", fillcolor="#d6e6f7", shape="box", style="rounded,filled,dashed"];

    subgraph "cluster_/run_n2k" {
        label=<run_n2k>;
        style="rounded";
        color="#aab4bf";
        subgraph "cluster_/run_n2k/gpu_0" {
            label=<GPU 0>;
            style="rounded,filled";
            color="#dcbf9a";
            fillcolor="#fdf4ea";
            "/run_n2k/gpu_0" [label=<gpu_0<BR/>&lt;cudaProcess&gt;<BR/>1 thread<BR/>cores 12,13,14>, color="#c2691a", fillcolor="#fbdcc0", shape="box", style="rounded,filled"];
            "/run_n2k/gpu_0/commands/0" [label=<cudaCorrelator<BR/>kernel<BR/>1.06 ms · 2.53% of a frame>, color="#c2691a", fillcolor="#fbdcc0", shape="box", style="filled"];
            "/run_n2k/gpu_0/commands/1" [label=<sync_output<BR/>copy out>, color="#c2691a", fillcolor="#fbdcc0", shape="invtrapezium", style="filled"];
            "/run_n2k/gpu_0/commands/2" [label=<input: voltage<BR/>copy in>, color="#c2691a", fillcolor="#fbdcc0", shape="trapezium", style="filled"];
            subgraph "cluster_/run_n2k/gpu_0/mem" {
                label=<device memory>;
                style="rounded";
                color="#aab4bf";
                "/run_n2k/gpu_0/mem/correlation" [label=<correlation<BR/>array ×4>, color="#b01a6b", fillcolor="#fbd9ea", shape="oval", style="filled"];
                "/run_n2k/gpu_0/mem/voltage" [label=<voltage<BR/>array ×4>, color="#b01a6b", fillcolor="#fbd9ea", shape="oval", style="filled"];
            }
        }
    }

    "/buffer_send_n2_full" [label=<buffer_send_n2_full<BR/>&lt;bufferSend&gt;<BR/>1 thread<BR/>cores 0,1,8>, color="#7549a8", fillcolor="#e6dcf5", shape="box", style="rounded,filled"];
    "/buffer_send_n2_full/destination" [label=<10.222.0.51:11027>, color="#2b7a63", fillcolor="#d3ece4", shape="doubleoctagon", style="filled"];

    "/gen/voltage" -> "host_voltage_buffer" [weight="4"];
    "host_voltage_buffer" -> "/run_n2k/gpu_0" [weight="4"];
    "/run_n2k/gpu_0/commands/2" -> "/run_n2k/gpu_0/commands/0" [style="dotted"];
    "/run_n2k/gpu_0/commands/0" -> "/run_n2k/gpu_0/commands/1" [style="dotted"];
    "/run_n2k/gpu_0/mem/voltage" -> "/run_n2k/gpu_0/commands/0" [style="solid"];
    "/run_n2k/gpu_0/commands/0" -> "/run_n2k/gpu_0/mem/correlation" [style="solid"];
    "/run_n2k/gpu_0" -> "host_full_buffer" [weight="4"];
    "host_full_buffer" -> "/buffer_send_n2_full" [weight="4"];
    "/buffer_send_n2_full" -> "/buffer_send_n2_full/destination";
    "/gen/voltage" -> "host_idle_buffer";

    subgraph "cluster___legend" {
        label=<legend>;
        style="rounded";
        color="#aab4bf";
        "__legend/buffer" [label=<buffer: name / type · metadata / layout / size / fill>, color="#2a6099", fillcolor="#d6e6f7", shape="box", style="rounded,filled"];
        "__legend/compute" [label=<stage on the CPU>, color="#94800c", fillcolor="#f7edc0", shape="box", style="rounded,filled"];
        "__legend/gpu" [label=<GPU stage and its commands>, color="#c2691a", fillcolor="#fbdcc0", shape="box", style="rounded,filled"];
        "__legend/io" [label=<stage moving data on or off this machine>, color="#7549a8", fillcolor="#e6dcf5", shape="box", style="rounded,filled"];
        "__legend/memory" [label=<device memory (not a kotekan buffer)>, color="#b01a6b", fillcolor="#fbd9ea", shape="oval", style="filled"];
        "__legend/endpoint" [label=<the far end: a socket, a port, a file>, color="#2b7a63", fillcolor="#d3ece4", shape="doubleoctagon", style="filled"];
        "__legend/buffer" -> "__legend/compute" [style="invis"];
    }
}
