[Unit]
Description=choco job: EOP table broadcast
Requires=choco.service
After=choco.service

[Service]
Type=oneshot
ExecStart=/opt/choco/jobs/eop-broadcast.sh /etc/choco/config.yaml
# Retry forever so the job self-recovers when the FPGA master comes back.
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=0

[Install]
WantedBy=choco.service
