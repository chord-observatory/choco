[Unit]
Description=choco job: bffs bad-feed flag broadcast
Requires=choco.service
After=choco.service

[Service]
Type=oneshot
# systemd owns /var/lib/choco/bffs (creates it with the right ownership) and
# exports it as $STATE_DIRECTORY; state.json, run.json and the manual
# override file live there, and choco reads them from the same place.
StateDirectory=choco/bffs
ExecStart=/opt/choco/jobs/bffs/bffs-flag.sh /etc/choco/bffs.yaml
# No Restart: bffs sends only on change and records state after a successful
# send, so a failed run (choco not up yet, N2 file missing) is simply retried
# by the next timer tick.

[Install]
WantedBy=choco.service
