[Unit]
Description=choco job: drift-scan sky maps, frequency as colour
Requires=choco.service
After=choco.service

[Service]
Type=oneshot
# systemd owns /var/lib/choco/mapmaker (creates it with the right ownership)
# and exports it as $STATE_DIRECTORY; the map accumulators, gains, state.json
# and the run lock live there.
StateDirectory=choco/mapmaker
# The same account as the waterfall renderer: it reads the same NFS tree
# and nothing it writes needs root.
User=choco
Group=choco
ExecStart=/opt/choco/jobs/run-job.sh mapmaker/mapmaker.py /etc/choco/mapmaker.yaml
# No Restart: the script self-gates and caps its own work (max_files_per_run),
# so a run that fails -- mount unavailable, a file unreadable -- is simply
# retried by the next timer tick.  Exit 2 = degraded (a dependency missing,
# or no calibrator transit seen yet); 1 = config error / bug.
Nice=10
IOSchedulingClass=idle
# Hold the job to half the box and yield to anything else that wants the CPU
# (see choco-waterfall.service for why CPUWeight is the setting that bites).
CPUQuota=200%
CPUWeight=20
# Page cache from the source files is read-once (MemoryHigh reclaims it from
# this cgroup rather than the box).  The job's own footprint, measured
# 2026-10-18 on the 128-element subset files (64 dishes per polarization,
# 2016 products, 6145 channels, 97 sub-bands): the imaging kernels 1.0 GB
# (112 unique baselines x 81 Dec rows x up to 355 columns per sub-band),
# the calibration sums 0.6 GB, the gains 0.2 GB, the maps 0.26 GB, the
# reduced file 0.19 GB, plus the chunk being read and the gain solve's
# temporaries; the run peaked past 4.3 GB.  At the former 2G line a run
# spent 60% of its time stalled in reclaim and took 25 min per file, so a
# 400 s file cadence could never be kept.  High is the working budget
# with headroom for a larger array; MemoryMax is the backstop that turns
# a runaway into a red badge instead of a system-wide OOM.
MemoryHigh=6G
MemoryMax=8G
