[Unit]
Description=choco job: deconvolve the drift-scan sky map (CLEAN)
Requires=choco.service
After=choco.service choco-mapmaker.service

[Service]
Type=oneshot
# The mapmaker's own state directory: the deconvolution reads maps.npz
# there and writes clean.png / clean-strip.png / clean.json beside it.
StateDirectory=choco/mapmaker
User=choco
Group=choco
ExecStart=/opt/choco/jobs/run-job.sh mapmaker/clean.py /etc/choco/mapmaker.yaml
# No Restart: the script self-gates (nothing to do until the fold-in has
# added data) and a failed run is simply retried by the next timer tick.
# Exit 2 = degraded (no accumulators or geometry yet); 1 = config error / bug.
Nice=10
IOSchedulingClass=idle
# A deconvolution is a few minutes of numpy; keep it off the fold-in's
# and choco's CPU.
CPUQuota=200%
CPUWeight=20
# The accumulators (~260 MB), the kernels it rebuilds for the imaged
# sub-bands (1.0 GB at 128 elements, measured 2026-10-18; the same
# kernels the fold-in holds) and the dirty beam rows it visits (a few MB
# each, at most one per Dec row).
MemoryHigh=3G
MemoryMax=4G
